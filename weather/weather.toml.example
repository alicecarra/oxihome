# Copy to weather.toml (kept out of git: it holds the location and the broker password).

[mqtt]
host = "localhost"
port = 1883
password = "the node's broker password"
# Outgoing messages waiting to be sent; new ones are dropped while it is full.
# queue_size = 4096

[node]
id = "weather"

# A public place near home is precise enough for the weather (this one is Parque Farroupilha in Porto Alegre).
[location]
latitude = -30.04
longitude = -51.22
