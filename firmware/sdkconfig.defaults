# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# Might have to increase this further if you allocate large stack variables in the main task
# 24K because oxihome-protocol is built unoptimized (see Cargo.toml), and unoptimized serde uses a lot of stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# Might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Over-the-air updates: the bootloader rolls back a new image that does not mark itself valid.
# The partition tables (two app slots) are partitions-<flash>.csv, written by flash.sh.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
