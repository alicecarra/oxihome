# Copy to cfg.toml (ignored by git) and fill in.
[firmware]
wifi_ssid = "my-network"
wifi_password = "my-password"
mqtt_url = "mqtt://192.168.0.10:1883"
# Each board has its own password; its user name on the broker is its device id (esp32-<mac>).
mqtt_password = "the board's broker password"
# What is wired besides the onboard LED and BOOT button: climate, external_led, buzzer, ir,
# potentiometer. Without this line, all of them; "" for none.
peripherals = "climate, external_led, buzzer, ir, potentiometer"
# ESP-NOW leaf (stays off the broker; its gateway carries its messages): the gateway's device id,
# and the key printed by espnow-key.sh. mqtt_url and mqtt_password are not used then.
#espnow_gateway = "esp32-..."
#espnow_key = "..."
# ESP-NOW gateway: its leaves' device ids, and a secret the leaves' keys come from
# (openssl rand -hex 16). Each leaf also needs lines in the broker's acl (see docs/firmware/espnow.md).
#espnow_leaves = "esp32-..., esp32-..."
#espnow_secret = "..."
# Read only by build-images.sh: esp32 (default) or esp32c6.
#chip = "esp32c6"
# Read by build-images.sh and flash.sh: picks partitions-<flash>.csv; 4mb without it.
#flash = "16mb"
