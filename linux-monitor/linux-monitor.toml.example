# Copy to linux-monitor.toml (kept out of git: it is per machine and holds the broker password).

[mqtt]
host = "localhost"
port = 1883
password = "the node's broker password"
# Outgoing messages waiting to be sent; new ones are dropped while it is full.
# queue_size = 4096

# Without an id the node takes the hostname.
[node]
id = "desktop"

# Entity ids follow the order of these lists, so add new ones at the end.
# The program prints the mount points and interfaces of the machine when it starts.
[monitor]
disks = ["/"]
interfaces = ["wlan0"]
# Names as `docker ps` shows them; the user needs to be in the docker group.
containers = ["pihole", "jellyfin"]
# docker_socket = "/var/run/docker.sock"   # Podman without root: "/run/user/1000/podman/podman.sock"
